# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/jellyai"

# Auth session. Keep this long and random in production.
SESSION_SECRET="replace-with-a-long-random-session-secret"

# Platform admin seed account.
ADMIN_EMAIL="admin@jellyai.local"
ADMIN_PASSWORD="ChangeMe123!"

# Demo tenant/customer seed account for the customer-facing app.
TENANT_EMAIL="tenant@jellyai.local"
TENANT_PASSWORD="ChangeMe123!"
SEED_TENANT_NAME="欧诚国际物流"

# Model runtime configuration. Store real keys only in .env.local or deployment secrets.
MODEL_API_KEY=""
OPENAI_API_KEY=""
MODEL_BASE_URL="https://api.openai.com/v1"

# Optional real integrations. The fullstack V1 local build keeps these mocked
# unless credentials and webhook/RPA workers are configured.
WECOM_WEBHOOK_SECRET=""
WECOM_RPA_BASE_URL=""
VECTOR_DATABASE_URL=""
OBJECT_STORAGE_BUCKET=""

# Runtime
NODE_ENV="development"
ADMIN_WEB_URL="http://localhost:3000"
ADMIN_API_ORIGIN="http://localhost:3000"
CUSTOMER_WEB_URL="http://127.0.0.1:3001"
CUSTOMER_WEB_HOST="127.0.0.1"
CUSTOMER_WEB_PORT="3001"

# Backward-compatible aliases used by earlier local builds.
AUTH_SECRET=""
SEED_ADMIN_ACCOUNT=""
SEED_ADMIN_PASSWORD=""
SEED_TENANT_ACCOUNT=""
SEED_TENANT_PASSWORD=""
