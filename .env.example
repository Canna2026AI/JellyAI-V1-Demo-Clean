# Jelly WeCom backend
HOST=127.0.0.1
PORT=8787
JELLY_REQUIRE_AUTH=0
JELLY_ADMIN_EMAIL=admin@jelly.local
JELLY_ADMIN_PASSWORD=change-this-before-production
JELLY_WECOM_DB=backend/data/wecom-db.json

# Enterprise WeChat official API credentials
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# Optional RPA/managed-client executor for real PC WeCom actions.
# The backend will POST { action, payload } to this URL for send text/image/file,
# create group, invite members, rename group, and group notice actions.
WECOM_RPA_WEBHOOK_URL=
WECOM_RPA_TOKEN=
WECOM_RPA_TIMEOUT_MS=15000

# Set this if the static frontend is served from another origin during local dev.
JELLY_CORS_ORIGIN=
